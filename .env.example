# Server and Domain Configuration
DOMAIN=scandoc.yourdomain.com
PORT=3000
NODE_ENV=production

# MongoDB Database Connection
MONGO_URI=mongodb://scandoc_user:scandoc_password@mongo:27017/scandoc?authSource=admin

# JWT Secrets for Authentication
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min32chars
REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# File Storage & Limits
UPLOAD_DIR=/data/uploads
MAX_USER_BYTES=1073741824 # 1GB default quota per user

# AI Studio injected variables (at development time)
GEMINI_API_KEY=""
APP_URL=""
